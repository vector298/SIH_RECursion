# Copy to .env. Every setting has a working default — the service starts with
# none of these set, using SQLite and local model fallbacks.

# --- database -------------------------------------------------------------
# Default (nothing set): a SQLite file next to the app. Zero setup.
#
# For PostgreSQL, uncomment and fill in. Never commit the real password —
# .env is gitignored for exactly this reason.
# CASEINTEL_DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/personmatch
#
# Requires the driver:  pip install "psycopg[binary]"
# Check the connection: python scripts/check_db.py

# --- Gemini ---------------------------------------------------------------
# PUT YOUR API KEY HERE. Uncomment the line and paste the key after the '='.
# Get one free at https://aistudio.google.com/apikey
#
# CASEINTEL_GEMINI_API_KEY=AIza...
#
# With a key set, the system uses Gemini for:
#   - structured extraction of marks from the officer's free text
#   - text embeddings for semantic comparison of those marks
#   - plain-English narration of scores the pipeline already computed
#   - image quality and soft-attribute observations
#
# Without one, all four fall back to deterministic local implementations and
# every response says which produced it. Nothing breaks either way.
#
# Verify the key end to end:  python scripts/check_gemini.py
#
# Gemini is NOT used for face identification — it has no face-embedding
# endpoint and identifying people from photos is outside its usage policy.
# That is ArcFace's job (app/services/face.py).
#
# Model names are a PREFERENCE, not a requirement. Google retires model IDs on
# its own schedule — text-embedding-004 was withdrawn and gemini-2.5-flash closed
# to new keys during development — so the provider asks your key what it can
# reach and substitutes the nearest equivalent, logging what it chose. A stale
# name here costs nothing. Pin them before a demo so nothing shifts mid-talk.
# CASEINTEL_GEMINI_MODEL=gemini-3.6-flash
# CASEINTEL_GEMINI_EMBED_MODEL=gemini-embedding-001
# CASEINTEL_GEMINI_EMBED_DIM=768
# CASEINTEL_GEMINI_PIN_MODELS=false     # true: fail rather than substitute
# CASEINTEL_GEMINI_TIMEOUT_S=20

# --- face recognition -----------------------------------------------------
# Requires: pip install -r requirements-models.txt
# The pack downloads on first use into CASEINTEL_FACE_MODEL_ROOT.
# CASEINTEL_FACE_MODEL_PACK=buffalo_l
# CASEINTEL_FACE_MODEL_ROOT=./models

# --- matching -------------------------------------------------------------
# CASEINTEL_HARD_SEARCH_GEO_DEGREES=14.0
# CASEINTEL_MAX_CANDIDATES_RETURNED=12
# CASEINTEL_MIN_CONFIDENCE_RETURNED=0.30

# --- server ---------------------------------------------------------------
# CASEINTEL_DEBUG=false
# CASEINTEL_CORS_ORIGINS=["http://localhost:5173"]
